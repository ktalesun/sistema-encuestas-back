NODE_ENV=production
PORT=3001
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=cambia_esto
DB_DATABASE=sistema_encuestas
DB_SYNCHRONIZE=true
JWT_SECRET=cambia_esto_en_produccion
JWT_EXPIRATION=7d

# PostgreSQL (contenedor postgres)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_esto
POSTGRES_DB=sistema_encuestas
POSTGRES_HOST_AUTH_METHOD=trust

# pgAdmin (contenedor pgadmin)
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=cambia_esto
PGADMIN_CONFIG_SERVER_MODE='False'
